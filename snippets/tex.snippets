snippet note "note template" b
	\documentclass[class=article, crop=false]{standalone}
	\usepackage[subpreambles=true]{standalone}
	\usepackage{zk}

	\begin{document}

	\section{${1:Title}}
	\label{$TM_FILENAME_BASE-first}
	\keywords{${2:Keywords}}

	$3

	\end{document}

snippet beg "begin and block" b
	\begin{$1}

	$2

	\end{$1}

snippet sec "section{} and label{}" b
	\section{${1:SecName}}

	$2

snippet sub "subsection{} and label" b
	\subsection{${1:SubName}}

	$2

snippet subs "subsubsection{} and label" b
	\subsubsection{${1:SubsubName}}

	$2

snippet enum "Enumerate list" b
	\begin{enumerate}
		\item $1
	\end{enumerate}


snippet itm "Itemised list" b
	\begin{itemize}
		\item $1
	\end{itemize}


snippet it "Item line" i
	\item $1

snippet fig "figure and label" b
	\begin{figure}[H]
		\centering
		\includegraphics[angle=0,width=1.0\textwidth]{${1:Filename}}
		\caption{${2:Caption}}
		\label{fig:${3:label}}
	\end{figure}

snippet tabl "add table" b
	\begin{table}[H]
	\caption{${1:Description}}
	\label{tab:${2:label}}
	\centering
		\begin{tabular}{+l^c}
			\rowstyle{\itshape}
			 Label1 & Label2 \\\\
			Full spectrum & 0.358 \\\\
			Narrow band & 0.343 \\\\
		\end{tabular}
	\end{table}

snippet em "emphasize" i
	\emph{$1}$0


snippet bf "bold" i
	\textbf{$1}$0

snippet lsi "Inline listing"
	\\lstinline|${1}| ${0}

snippet url "URL"
	\\url{${1}} ${0}

snippet href "Hyperref"
	\\href{${1}}{${2}} ${0}

snippet urlc "URL clipboard" i
	\\url{`@+`} ${0}

snippet hrefc "Hyperref clipboard" i
	\\href{`@+`}{${1}} ${0}

snippet m "Math Environment"
	$${1}$

snippet mc "Centered Math Environment"
	$$${1}$$

snippet shf "Sheaf"
	[${1}, ${2}]

snippet cat "Category"
	\mathbf{${1}}

snippet f "Function"
	$${1} : ${2} \rightarrow ${3}$

snippet fm "Map"
	$${1} \mapsto ${2}$

snippet iso "Isomorphic To"
	\cong ${1}

snippet int "Intersection"
	\bigcap\limits_{\substack{${1}}}

snippet ker "Kernel"
	\ker(${1})

snippet normto "Normal To (From and To)"
	${1}\trianglelefteq ${2}

snippet null "Empty Set"
	\emptyset

snippet leqq "Less Than or Equal To"
	${1}\leq${2}

snippet geqq "Greater Than or Equal To"
	${1}\geq${2}

snippet inv "Inverse"
	${1}^{-1}

snippet inn "In"
	${1}\in${2}

snippet nin "Not In"
	${1}\not\in${2}

snippet qtnt "Quotient Notation"
	{}^{${1}}/_{${2}}

snippet set "Sets"
	\{ ${1} \}

snippet bks "Brackets"
	\langle ${1} \rangle

snippet setb "Set Builder Notation"
	\{ ${1} | ${2} \}

snippet abs "Absolute Value"
	\left|${1}\right|

snippet eqq "Equals To"
	${1} = ${2}

snippet com "Set of Complex Numbers"
	\mathbb{C}

snippet int "Set of Integer Numbers"
	\mathbb{Z}

snippet rel "Set of Real Numbers"
	\mathbb{R}

snippet relp "Set of Real Numbers to a Power"
	\mathbb{R}^{${1}}

snippet rat "Set of Rational Numbers"
	\mathbb{Q}

snippet nat "Set of Natural Numbers"
	\mathbb{N}

snippet til "Tilde Over Character"
	\tilde{${1}}

snippet iff "Bidirectional Arrow (Iff)"
	${1} \Longleftrightarrow ${2}

snippet dblr "Double Right Arrow"
	${1} \doublerightarrow{${3}}{${4}} ${2}
